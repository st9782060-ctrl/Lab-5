#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main() {
    double a, b, h;

    cout << "Enter segment start a (e.g. 0): ";
    cin >> a;
    cout << "Enter segment end b (e.g. 5): ";
    cin >> b;
    cout << "Enter step h (e.g. 0.5): ";
    cin >> h;

    if (h <= 0 || a > b) {
        cout << "Error: Invalid segment or step!" << endl;
        system("pause");
        return 1;
    }

    cout << "\n-------------------" << endl;
    cout << ":   X    :   Y    :" << endl;
    cout << "-------------------" << endl;

    double x = a;
    while (x <= b + 1e-9) {
        if (x < 0) {
            cout << "Error: x = " << x << " is out of domain (x < 0)!" << endl;
            break;
        }

        double y = sin(x) + sqrt(x);
        cout << ": " << setw(6) << fixed << setprecision(2) << x
             << " : " << setw(6) << setprecision(2) << y << " :" << endl;

        x += h;
    }

    cout << "-------------------" << endl;

    system("pause");
    return 0;
}
